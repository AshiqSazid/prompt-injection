# Copy to .env and fill in. .env is gitignored — never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# OpenRouter: one key proxies to all providers via the OpenAI-compatible API.
# Best for the open-model breadth grid; prefer native keys for the Gate.
OPENROUTER_API_KEY=
# GLM (Zhipu AI / Z.ai) — OpenAI-compatible. THREE endpoints exist and a key is
# usually valid for only one of them; picking the wrong one returns HTTP 429 with
# code 1113 ("insufficient balance"), which reads like an unfunded account but is
# actually a wrong-endpoint error. Auth failure is code 1000 — that is how you
# tell the two apart. Measured 2026-08-11 against a GLM Coding Lite subscription:
# the general endpoints returned 1113 while the coding one served the same key.
#   Coding Plan subscription  https://api.z.ai/api/coding/paas/v4
#   General API (pay-as-you-go, separate balance)
#                             https://api.z.ai/api/paas/v4        (providers.py default)
#   Zhipu mainland host       https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_BASE_URL=
# DeepSeek — OpenAI-compatible. Pin a CONCRETE model id from /models
# (deepseek-v4-flash, deepseek-v4-pro): `deepseek-chat` and `deepseek-reasoner`
# are moving aliases that resolve to whatever is current, and the substitution
# guard in providers.call rejects them for that reason.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
